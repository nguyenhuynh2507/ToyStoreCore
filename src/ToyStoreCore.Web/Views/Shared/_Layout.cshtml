<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ToyStoreCore</title>

    <!-- Google Fonts: Montserrat + Inter (theme Oracle) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- CSS riêng của ToyStoreCore (class .product-grid, .data-table, .cart-row, .admin-dropdown...) nạp TRƯỚC -->
    <link rel="stylesheet" href="~/css/postgres-legacy.css" />
    <!-- CSS copy từ bản Oracle - nạp SAU để ghi đè theme (màu/font/nav/button) -->
    <link rel="stylesheet" href="~/css/layout.css?v=2" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark custom-navbar">
            <div class="container-fluid">
                <a class="navbar-brand brand-logo" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-cube"></i> ToyStoreCore
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="fas fa-store"></i> Sản phẩm
                            </a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-cog"></i> Quản trị
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark">
                                    <li><a class="dropdown-item" asp-controller="AdminProducts" asp-action="Index"><i class="fas fa-box"></i> Sản phẩm</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminCategories" asp-action="Index"><i class="fas fa-list"></i> Danh mục</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminBanners" asp-action="Index"><i class="fas fa-image"></i> Banner</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminPromotions" asp-action="Index"><i class="fas fa-gift"></i> Khuyến mãi</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminCustomers" asp-action="Index"><i class="fas fa-users"></i> Khách hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminOrders" asp-action="Index"><i class="fas fa-clipboard-list"></i> Đơn hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminGoodsReceipt" asp-action="Index"><i class="fas fa-warehouse"></i> Nhập kho</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminActivityLog" asp-action="Index"><i class="fas fa-history"></i> Nhật ký hoạt động</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminStaff" asp-action="Index"><i class="fas fa-user-tie"></i> Nhân viên</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminWorkShift" asp-action="Index"><i class="fas fa-calendar-alt"></i> Ca làm việc</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminPayroll" asp-action="Index"><i class="fas fa-money-check-alt"></i> Bảng lương</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminPos" asp-action="Index"><i class="fas fa-cash-register"></i> Bán hàng POS</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminRevenue" asp-action="Index"><i class="fas fa-tags"></i> Doanh thu</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminProfit" asp-action="Index"><i class="fas fa-chart-pie"></i> Lợi nhuận gộp</a></li>
                                    <li><a class="dropdown-item" asp-controller="AdminStatistics" asp-action="Index"><i class="fas fa-chart-line"></i> Thống kê</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="AdminPos" asp-action="Index">
                                    <i class="fas fa-cash-register"></i> POS bán hàng
                                </a>
                            </li>
                        }

                        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") && !User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="MyOrders">
                                    <i class="fas fa-receipt"></i> Đơn hàng của tôi
                                </a>
                            </li>
                        }
                        @if (!User.IsInRole("Admin") && !User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                    <i class="fas fa-shopping-cart"></i> Giỏ hàng @await Component.InvokeAsync("CartBadge")
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown" id="support-dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-headset"></i> Hỗ trợ
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" href="mailto:support@toystorecore.local">
                                        <i class="fas fa-envelope"></i> Email: support@toystorecore.local
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="tel:0123456789">
                                        <i class="fas fa-phone"></i> Hotline: 0123 456 789
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-greeting" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="fas fa-user-circle"></i> @User.Identity!.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                    <li class="dropdown-item-text">@await Component.InvokeAsync("MembershipStatus")</li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="fas fa-user-edit"></i> Thông tin cá nhân
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item w-100 text-start">
                                                <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn-login" asp-controller="Account" asp-action="Login">
                                    <i class="fas fa-sign-in-alt"></i> Đăng nhập
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link btn-register" asp-controller="Account" asp-action="Register">
                                    <i class="fas fa-user-plus"></i> Đăng ký
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Message"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer">
        <div class="container">
            <p>&copy; @DateTime.Now.Year - ToyStoreCore</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
