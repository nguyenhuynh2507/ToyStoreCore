@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<h1>Cảm ơn bạn đã đặt hàng!</h1>
<p>Mã đơn hàng: <strong>#@Model.Id</strong></p>
<p>Trạng thái: @Model.Status</p>

<h3>Chi tiết đơn hàng</h3>
<table class="data-table">
    <thead>
        <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.UnitPrice.ToString("N0") đ</td>
                <td>@item.Quantity</td>
                <td>@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
            </tr>
        }
    </tbody>
</table>
<p class="cart-total" style="text-align:left; font-weight:400; font-size:1rem;">
    Tạm tính: @Model.Subtotal.ToString("N0") đ
    @if (!string.IsNullOrEmpty(Model.PromoCode))
    {
        <br />
        <text>Mã @Model.PromoCode: -@Model.PromoDiscount.ToString("N0") đ</text>
    }
    @if (Model.MembershipDiscount > 0)
    {
        <br />
        <text>Ưu đãi thành viên: -@Model.MembershipDiscount.ToString("N0") đ</text>
    }
</p>
<p class="cart-total">Tổng cộng: @Model.TotalAmount.ToString("N0") đ</p>

<p>
    <strong>Giao đến:</strong> @Model.CustomerName - @Model.PhoneNumber<br />
    @Model.ShippingAddress
</p>

<a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a>

@if (Model.Status == OrderStatus.Pending && Model.UserId != null
    && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.UserId)
{
    <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Id" method="post"
          onsubmit="return confirm('Hủy đơn hàng này?');" style="display:inline; margin-left:10px;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-danger">Hủy đơn hàng</button>
    </form>
}
