@model List<WorkShift>
@{
    ViewData["Title"] = "Ca làm việc";
    var staffList = (SelectList)ViewBag.StaffList;
    int month = ViewBag.Month;
    int year = ViewBag.Year;
    string? status = ViewBag.Status;
    string[] statusOptions = ViewBag.StatusOptions;
}

<h1>Quản lý ca làm việc</h1>

<p><a class="btn btn-primary" asp-controller="AdminWorkShift" asp-action="Create">+ Phân ca mới</a></p>

<form method="get" class="filter-bar">
    <select name="staffId" asp-items="staffList" onchange="this.form.submit()">
        <option value="">Tất cả nhân viên</option>
    </select>
    <input type="number" name="month" value="@month" min="1" max="12" style="width:70px;" />
    <input type="number" name="year" value="@year" min="2000" max="2100" style="width:90px;" />
    <select name="status" onchange="this.form.submit()">
        <option value="">Tất cả trạng thái</option>
        @foreach (var s in statusOptions)
        {
            <option value="@s" selected="@(s == status)">@s</option>
        }
    </select>
    <button type="submit" class="btn btn-secondary">Lọc</button>
</form>

<table class="data-table">
    <thead>
        <tr><th>Nhân viên</th><th>Ngày</th><th>Ca</th><th>Trạng thái</th><th>Ghi chú</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var w in Model)
        {
            <tr>
                <td>@(w.Staff?.FullName ?? w.StaffUserId)</td>
                <td>@w.WorkDate.ToString("dd/MM/yyyy")</td>
                <td>@w.ShiftName</td>
                <td>@w.Status</td>
                <td>@(w.Note ?? "—")</td>
                <td>
                    @if (w.Status == HrConstants.StatusPending)
                    {
                        <form asp-controller="AdminWorkShift" asp-action="UpdateStatus" method="post" style="display:flex; gap:6px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="shiftId" value="@w.Id" />
                            <input type="hidden" name="month" value="@month" />
                            <input type="hidden" name="year" value="@year" />
                            <input type="hidden" name="staffId" value="@w.StaffUserId" />
                            <input type="hidden" name="filterStatus" value="@status" />
                            <button type="submit" name="status" value="@HrConstants.StatusCompleted" class="btn btn-primary" style="padding:4px 10px;">Hoàn thành</button>
                            <button type="submit" name="status" value="@HrConstants.StatusAbsent" class="btn btn-danger" style="padding:4px 10px;">Vắng</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
