@model CreateGoodsReceiptViewModel
@{
    ViewData["Title"] = "Tạo phiếu nhập kho";
    var products = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Products;
    var productOptions = products.ToList();
}

<h1>Tạo phiếu nhập kho</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="AdminGoodsReceipt" asp-action="Create" method="post" id="receiptForm">
    @Html.AntiForgeryToken()

    <div style="display:flex; gap:20px; margin-bottom:20px; flex-wrap:wrap;">
        <div class="field" style="flex:1; min-width:200px;">
            <label>Ngày nhập</label>
            <input asp-for="ImportDate" type="date" />
        </div>
        <div class="field" style="flex:2; min-width:260px;">
            <label>Ghi chú (tùy chọn)</label>
            <input asp-for="Note" placeholder="Ghi chú phiếu nhập..." />
        </div>
    </div>

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
        <h3 style="margin:0;">Chi tiết sản phẩm</h3>
        <button type="button" id="btnAddRow" class="btn btn-secondary">+ Thêm dòng</button>
    </div>

    <table class="data-table" id="detailTable">
        <thead>
            <tr><th>Sản phẩm</th><th>Số lượng</th><th>Giá nhập (đ)</th><th>Thành tiền</th><th></th></tr>
        </thead>
        <tbody id="detailRows">
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <select name="Details[@i].ProductId" class="product-select">
                            <option value="">-- Chọn sản phẩm --</option>
                            @foreach (var opt in productOptions)
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        </select>
                    </td>
                    <td><input name="Details[@i].Quantity" type="number" min="1" value="1" class="qty-input" /></td>
                    <td><input name="Details[@i].ImportPrice" type="number" min="0" step="1000" class="price-input" placeholder="0" /></td>
                    <td class="line-total">0 đ</td>
                    <td><button type="button" class="btn btn-danger btn-remove-row">Xóa</button></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" style="text-align:right; font-weight:600;">Tổng chi phí nhập kho</td>
                <td id="totalCostDisplay" style="font-weight:700;">0 đ</td>
                <td></td>
            </tr>
        </tfoot>
    </table>

    <button type="submit" class="btn btn-primary" style="margin-top:16px;">Lưu phiếu nhập</button>
</form>

<template id="rowTemplate">
    <tr class="detail-row">
        <td>
            <select name="Details[__INDEX__].ProductId" class="product-select">
                <option value="">-- Chọn sản phẩm --</option>
                @foreach (var opt in productOptions)
                {
                    <option value="@opt.Value">@opt.Text</option>
                }
            </select>
        </td>
        <td><input name="Details[__INDEX__].Quantity" type="number" min="1" value="1" class="qty-input" /></td>
        <td><input name="Details[__INDEX__].ImportPrice" type="number" min="0" step="1000" class="price-input" placeholder="0" /></td>
        <td class="line-total">0 đ</td>
        <td><button type="button" class="btn btn-danger btn-remove-row">Xóa</button></td>
    </tr>
</template>

<script>
    (function () {
        const tbody = document.getElementById('detailRows');
        const template = document.getElementById('rowTemplate');
        const totalDisplay = document.getElementById('totalCostDisplay');

        function reindexRows() {
            tbody.querySelectorAll('.detail-row').forEach((row, index) => {
                row.querySelectorAll('select, input').forEach(el => {
                    el.name = el.name.replace(/Details\[\d+\]/, `Details[${index}]`);
                });
            });
        }

        function formatVnd(n) {
            return new Intl.NumberFormat('vi-VN').format(Math.round(n)) + ' đ';
        }

        function recalcRow(row) {
            const qty = parseFloat(row.querySelector('.qty-input')?.value) || 0;
            const price = parseFloat(row.querySelector('.price-input')?.value) || 0;
            const lineTotal = qty * price;
            row.querySelector('.line-total').textContent = formatVnd(lineTotal);
            return lineTotal;
        }

        function recalcTotal() {
            let total = 0;
            tbody.querySelectorAll('.detail-row').forEach(row => { total += recalcRow(row); });
            totalDisplay.textContent = formatVnd(total);
        }

        tbody.addEventListener('input', (e) => {
            if (e.target.classList.contains('qty-input') || e.target.classList.contains('price-input')) {
                recalcTotal();
            }
        });

        tbody.addEventListener('click', (e) => {
            if (e.target.classList.contains('btn-remove-row')) {
                if (tbody.querySelectorAll('.detail-row').length > 1) {
                    e.target.closest('tr').remove();
                    reindexRows();
                    recalcTotal();
                }
            }
        });

        document.getElementById('btnAddRow').addEventListener('click', () => {
            const index = tbody.querySelectorAll('.detail-row').length;
            const html = template.innerHTML.replaceAll('__INDEX__', index);
            tbody.insertAdjacentHTML('beforeend', html);
        });

        recalcTotal();
    })();
</script>
