@model Promotion
@{
    ViewData["Title"] = "Thêm khuyến mãi";
}

<h1>Thêm mã khuyến mãi mới</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="AdminPromotions" asp-action="Create" method="post" style="max-width:500px;">
    @Html.AntiForgeryToken()
    <div class="field">
        <label>Mã code</label>
        <input asp-for="PromotionCode" placeholder="VD: SALE50" />
    </div>
    <div class="field">
        <label>Tên chương trình</label>
        <input asp-for="PromotionName" placeholder="VD: Giảm giá hè" />
    </div>
    <div class="field">
        <label>Loại giảm giá</label>
        <select asp-for="DiscountType">
            <option value="@PromotionDiscountType.Percentage">Giảm theo %</option>
            <option value="@PromotionDiscountType.FixedAmount">Giảm tiền mặt</option>
        </select>
    </div>
    <div class="field">
        <label>Giá trị giảm</label>
        <input asp-for="DiscountValue" type="number" step="0.01" min="0" />
    </div>
    <div class="field">
        <label>Giá trị đơn tối thiểu (đ)</label>
        <input asp-for="MinOrderValue" type="number" step="1000" min="0" />
    </div>
    <div class="field">
        <label>Ngày bắt đầu</label>
        <input asp-for="StartDate" type="datetime-local" />
    </div>
    <div class="field">
        <label>Ngày kết thúc</label>
        <input asp-for="EndDate" type="datetime-local" />
    </div>
    <div class="field">
        <label>Giới hạn lượt dùng (0 = không giới hạn)</label>
        <input asp-for="UsageLimit" type="number" min="0" />
    </div>
    <div class="field">
        <label><input asp-for="IsActive" type="checkbox" style="width:auto;" /> Kích hoạt ngay</label>
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
</form>
